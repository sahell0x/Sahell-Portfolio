# ============================================================================
# Portfolio voice agent — copy to `.env` (in THIS directory) and fill in the
# two credentials. Everything below already has a working default.
#
#   cd backend
#   cp .env.example .env
#   docker compose up -d --build
#
# docker-compose.yml lives beside this file and reads it for both ${VAR}
# substitution and the container's environment, so this is the only file to
# edit when deploying.
#
# The audio rides a plain WebSocket served by this process, so there is no
# media service to sign up for and nothing to pay per minute of conversation.
# ============================================================================

# ---- Sarvam (speech) -------------------------------------------------------
# https://dashboard.sarvam.ai — one key covers both Saaras v3 (STT) and
# Bulbul v3 (TTS). New accounts get ₹100 of free credit.
SARVAM_API_KEY=

# ---- OpenAI (language model) -----------------------------------------------
OPENAI_API_KEY=

# ============================================================================
# Docker deployment
# ============================================================================

# The one place a port is named: uvicorn listens on it inside the container and
# compose publishes the same number on the host. Point nginx at
# http://127.0.0.1:${PORT} (and the same for the /ws/ upgrade block).
PORT=8000

# Interface the published port binds to. 127.0.0.1 keeps the API private to
# this machine — correct when nginx terminates TLS on the same box, and the
# only sane default for an API that trusts X-Forwarded-For. Use 0.0.0.0 only
# if the proxy is on another host, and firewall the port if you do.
BIND_HOST=127.0.0.1

# Names for the image, container, compose project and network. Change them if
# you run more than one copy on the same machine.
IMAGE_NAME=portfolio-voice-agent
IMAGE_TAG=latest
CONTAINER_NAME=voice-agent
COMPOSE_PROJECT_NAME=portfolio-backend
NETWORK_NAME=portfolio-backend

# Hard ceiling on container memory. Comfortable on a t3.small (2GB): all the
# heavy lifting is remote API calls, so this is an I/O relay, not compute.
MEMORY_LIMIT=1200M

# ============================================================================
# Defaults below — no changes needed to run.
# ============================================================================

# ---- models ----------------------------------------------------------------
LLM_MODEL=gpt-4o-mini
STT_MODEL=saaras:v3
TTS_MODEL=bulbul:v3
# Must be a speaker the TTS model actually ships, or every synthesis fails and
# the agent goes silent. Retired names that still turn up in old docs: "meera"
# (bulbul:v1) and "anushka", "manisha", "vidya", "arya" (bulbul:v2).
# bulbul:v3 speakers: priya, ritu, neha, pooja, simran, kavya, ishita, shreya,
# roopa, tanya, shruti, suhani, kavitha, rupali (female);
# aditya, rahul, rohan, amit, dev (male).
# Kaira is a woman and speaks in feminine forms in every language, so keep this
# to a female speaker.
TTS_VOICE=ritu
TTS_LANGUAGE=en-IN
# "unknown" puts Saaras v3 in auto-detect. This is what makes Hindi and
# Hinglish work; setting a fixed language code turns that off.
STT_LANGUAGE=unknown

# ---- session limits --------------------------------------------------------
SESSION_SECONDS=300
SESSION_WARN_SECONDS=270
MAX_TURNS=40
# 0 = no cap. Off on purpose: this is the only limit that turns away a NEW
# visitor rather than a heavy one, and the point of the site is to be read.
# Abuse is handled by the per-device and per-IP layers above. Set a number here
# only if cost needs a hard roof.
MAX_CONCURRENT_SESSIONS=0
# ---- Per-device limits (one browser profile) --------------------------------
# The device id is client-supplied, so these are the friendly layer, not the
# enforcement layer: they stop five tabs and a mashed button, and give the
# visitor a message that says what to do. The per-IP caps below are the ceiling.
# Three calls a day is the headline allowance, and what the page warns about
# before a visitor spends one. Keep the hourly cap strictly below the daily one
# or the hourly refusal fires first and quotes the wrong wait.
SESSIONS_PER_DEVICE_HOUR=2
SESSIONS_PER_DEVICE_DAY=3
# Seconds before the same browser may start again, measured from the START of
# the previous session so a long conversation isn't punished with a long wait.
SESSION_COOLDOWN_SECONDS=30
# Live sessions one network may hold at once. Above 1 so an office behind a
# single NAT isn't reduced to one visitor at a time.
MAX_SESSIONS_PER_IP=2

# The network ceiling, set a little above one person's allowance so a household
# or an office behind one NAT isn't spending a single visitor's budget.
SESSIONS_PER_IP_HOUR=3
SESSIONS_PER_IP_DAY=5

# Global daily ceiling on voice sessions. 0 = unlimited (the current choice).
# Set it to a number if you ever want a hard stop on spend; when the ceiling is
# reached the button degrades to free text chat instead of erroring.
DAILY_SESSION_CEILING=0

# ---- turn-taking -----------------------------------------------------------
# Compared with a strict >, so 3 means the visitor must say FOUR words before
# the agent stops talking. Raise it if background chatter cuts the agent off;
# 0 disables barge-in entirely.
INTERRUPTION_WORD_COUNT=3

# Sarvam defaults this on, which makes it strain to transcribe faint audio —
# background speech then arrives as a real multi-word transcript and trips the
# interruption gate. Turn it on only if a quiet talker is being missed.
HIGH_VAD_SENSITIVITY=false

# ---- text fallback ---------------------------------------------------------
TEXT_MESSAGES_PER_IP_HOUR=30
TEXT_MAX_CHARS=500

# ---- agent -----------------------------------------------------------------
# Also names the agent_data/<name>/ directory the prompt is written into.
AGENT_NAME=kaira
# Low enough to keep her grounded, high enough that she doesn't open every turn
# the same way. Drop it if she ever starts improvising facts.
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=220
WELCOME_MESSAGE=Hi there — I'm Kaira, Sahil's assistant. Ask me anything about his work, his projects, or the AI systems he builds.

# ---- audio -----------------------------------------------------------------
# What the browser captures at (Saaras wants 16k) and what it plays back at.
# Both are reported to the page in the session response, so they only need to
# be set here. The playback rate must stay the TTS model's native one or the
# synthesizer resamples every chunk and clicks between sentences.
STT_SAMPLE_RATE=16000
TTS_SAMPLE_RATE=22050

# ---- server ----------------------------------------------------------------
# Bind inside the container. Must stay 0.0.0.0 or the app is unreachable
# from the host; what gets exposed to the network is BIND_HOST above.
HOST=0.0.0.0
# PORT is set in the Docker deployment block at the top of this file.
LOG_LEVEL=INFO

# Where the browser should open its socket. Empty (the default) derives it from
# the request that asked for it, which is correct behind the bundled nginx
# config. Set it only if the socket lives on a different origin to the API.
PUBLIC_WS_URL=

# How long a session ticket stays claimable after POST /session. A tab that
# dies before its socket opens gets its slot back this soon.
CONNECT_GRACE_SECONDS=60

# Audio-path trace: one channel following a chunk from Sarvam to the socket,
# with everything else muted. See "Debugging choppy audio" in the README.
AUDIO_TRACE=1
AUDIO_TRACE_QUIET=1

# Sites allowed to call this API.
ALLOWED_ORIGINS=https://portfolio.sahellx.site,http://localhost:3000

# Trust X-Forwarded-For. Correct behind nginx; set false if exposed directly,
# otherwise a client can spoof its IP and bypass the rate limits.
TRUST_PROXY_HEADER=true
