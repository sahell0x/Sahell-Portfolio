# ============================================================================
# Root settings for `docker compose up` from this folder.
#
#   cp .env.example .env && docker compose up -d --build
#
# Only ports and URLs live here. App settings and secrets stay in
# frontend/.env and backend/.env.
# ============================================================================

# Ports on THIS machine. If one is taken, change it here and run
# `docker compose up -d --build` again.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Which interface the ports listen on. 127.0.0.1 = this machine only.
# Use 0.0.0.0 to reach the site from other devices on your network.
BIND_HOST=127.0.0.1

# ---- Optional ---------------------------------------------------------------
# Where the browser reaches the backend. Leave empty to use
# http://localhost:${BACKEND_PORT}. Set it for a public deployment.
# VOICE_API_URL=https://voice.sahellx.site

# Sites the backend accepts calls from. Leave empty to allow
# http://localhost:${FRONTEND_PORT}. Comma-separated.
# BACKEND_ALLOWED_ORIGINS=https://portfolio.sahellx.site

# Compose project name (prefix for containers and volumes).
# COMPOSE_PROJECT_NAME=portfolio
