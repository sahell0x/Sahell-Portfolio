# ============================================================================
# Portfolio frontend — copy to `.env` and fill in.
#
#   cp .env.example .env && docker compose up -d --build
#
# Compose reads this file for both ${VAR} substitution in docker-compose.yml
# and the container's own environment, so it is the only file to edit when
# deploying. (For `npm run dev` without Docker, Next reads .env.local instead.)
# ============================================================================

# ---- Docker deployment ------------------------------------------------------
# The one place a port is named: the Next server listens on it inside the
# container and compose publishes the same number on the host. Point nginx at
# http://127.0.0.1:${PORT}.
PORT=3000

# Interface the published port binds to. 127.0.0.1 keeps the app private to
# this machine — correct when nginx terminates TLS on the same box. Use
# 0.0.0.0 only if the proxy (or the browser) is on another host.
BIND_HOST=127.0.0.1

# Names for the image, container, compose project and network. Change them if
# you run more than one copy on the same machine.
IMAGE_NAME=portfolio-frontend
IMAGE_TAG=latest
CONTAINER_NAME=portfolio-frontend
COMPOSE_PROJECT_NAME=portfolio-frontend
NETWORK_NAME=portfolio-frontend

# Hard ceiling on container memory.
MEMORY_LIMIT=512M

# ---- Contact form (Resend) ---------------------------------------------
# Create a free API key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=s.sahil9752@gmail.com

# Verified sender. Until you verify your own domain in Resend, you can send
# from their shared onboarding address (works out of the box):
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# ---- Voice assistant ----------------------------------------------------
# Public URL of the voice-agent backend (backend/voice-agent).
# Must be https:// in production — the site is served over HTTPS, so a plain
# http:// endpoint is blocked as mixed content and the assistant won't connect.
# Local development: http://localhost:8000
#
# Baked into the browser bundle at BUILD time. After changing it, redeploy with
# `docker compose up -d --build` — a plain restart keeps the old value.
NEXT_PUBLIC_VOICE_API_URL=https://voice.sahellx.site
